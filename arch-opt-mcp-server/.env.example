# ================================================
# arch-opt-mcp-server 环境配置模板
# 复制为 .env 并填写真实值: cp .env.example .env
# ================================================

# Mock 数据开关（测试环境通常为 false，接口不可用时自动降级）
MCP_USE_MOCK=false

# 统一拓扑代理地址与鉴权参数（敏感凭据放此处，勿硬编码到代码/配置）
ARCH_PROXY_URL=https://easyviews.tech.ctseelink.cn/api/third/thirdAuth/getTykjProvince
ARCH_APP_ID=
ARCH_APP_SECRET=
ARCH_PROVINCE=大模型

# Prometheus 地址
ARCH_PROMETHEUS_URL=http://183.56.210.90:8082

# 日志级别：DEBUG/INFO/WARNING/ERROR
LOG_LEVEL=INFO

# 文件日志开关：false 时不写日志文件，仅控制台输出（Docker json-file 自动轮转）
LOG_TO_FILE=false

# ================================================
# 超时与重试（影响 agent 响应速度）
# ================================================

# 单次请求超时（秒）。默认 8
# ARCH_REQUEST_TIMEOUT=8

# 超时/连接失败重试次数（0=不重试）。默认 1
# ARCH_MAX_RETRIES=1

# 重试间隔（秒）。默认 1
# ARCH_RETRY_DELAY=1
