{
  "version": "2.2.0",
  "replica": {
    "min_replicas": 2,
    "min_replicas_note": "业务确认：至少 2 副本；spec < 2（单副本）判副本不足（2026-10-19 由 3 调整为 2）",
    "check_available_equal": true
  },
  "capacity": {
    "cpu_throttle_ratio": 0.20,
    "memory_usage_ratio": 0.85,
    "hpa_max_reached_check": true,
    "duration_minutes": 15
  },
  "load_balance": {
    "max_avg_ratio": 2.0,
    "duration_minutes": 15
  },
  "oom": {
    "lookback_days": 7,
    "lookback_note": "近期窗口需业务确认"
  },
  "link_dependency": {
    "min_in_degree": 2,
    "max_out_degree": 10,
    "error_rate_threshold": 0.05,
    "slow_call_ratio_threshold": 0.10,
    "min_sample_count": 20,
    "max_chain_depth": 4,
    "cycle_check": true,
    "slow_call_threshold_ms": null,
    "data_source": "arch-opt-mcp-server(mcp_link_dependency) + pinpoint-mcp-server(补充)",
    "provisional": true,
    "note": "D5 阈值均为建议值，待与真实数据联调确认；slow_call_threshold_ms 由 Pinpoint 服务端决定，当前未知"
  },
  "fault_domain": {
    "min_instance_to_check": 1,
    "max_host_concentration": 0.5,
    "same_host_all_risk": true,
    "partial_concentration_report": true,
    "data_source_available": true,
    "note": "数据源：getNode(getNode→ctyun_node_code3) + getVirtualStructure(ipData) + getTopologyInfo(projectIpData)；单宿主机集中比例超过 max_host_concentration 判风险"
  },
  "container_check": {
    "dep_suffix_filter": true,
    "note": "第一阶段仅对 projectName 以 -dep 结尾的应用执行容器检查"
  }
}
