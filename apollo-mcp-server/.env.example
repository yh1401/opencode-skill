# ================================================
# Apollo MCP Server 生产环境配置模板
# 复制为 .env 并填写真实值: cp .env.example .env
# ================================================

# Mock 数据开关（生产必须为 false）
MCP_USE_MOCK=false

# Apollo 环境（PRO/DEV/SIT/LOCAL，用于日志标识）
APOLLO_ENV=PRO

# ================================================
# 第三方「Apollo Host 信息查询接口」配置（推荐方式）
# 接口地址与 sessionId 默认值已内置在 mcp_server.py（ConfigClient），
# 默认不需要配置；如需覆盖（如本地测试指向 Mock: http://localhost:8066）再取消注释：
# ================================================

# 第三方接口地址（默认 https://easyops.tech.ctseelink.cn）
# APOLLO_HOST_API_BASE=https://easyops.tech.ctseelink.cn

# 第三方鉴权 sessionId（32位），同时是 token 解密密钥
# APOLLO_HOST_SESSION_ID=e5e27a7d1805758400287ae86741f889

# 可选：默认 Apollo 环境名称（多套中指定一套作为默认，模糊匹配；不填取第一条）。
# 查询时仍可通过 apollo_config_query / apollo_app_list 的 apolloHostId 参数指定任意套
# APOLLO_HOST_NAME=天翼云眼贵州

# 第三方接口配置刷新间隔（秒）
# CONFIG_SERVICE_REFRESH_SEC=60

# ================================================
# 超时与重试（影响 agent 响应速度）
# 正常请求毫秒级返回不受影响；以下仅在异常/超时时触发，快速失败避免 agent 卡死。
# 配置服务下发的 timeout/max_retries/traversal_budget 会覆盖这里的默认值。
# ================================================

# 业务查询单次超时（秒）：apollo_config_query 配置查询，6s 不重试快速失败。默认 6
# APOLLO_REQUEST_TIMEOUT=6

# 应用列表查询单次超时（秒）：apollo_app_list，6s 不重试快速失败。默认 6
# APOLLO_APPS_TIMEOUT=6

# Apollo Host 列表单次超时（秒）：apollo_host_list，8s + 1 次重试。默认 8
# APOLLO_HOST_LIST_TIMEOUT=8

# 单请求失败重试次数（0=不重试）。默认 1
# APOLLO_MAX_RETRIES=1

# 重试间隔（秒）。默认 1
# APOLLO_RETRY_DELAY=1

# 遍历可用套总预算（秒）：超过则提前终止，避免多套全超时累加。默认 20
# APOLLO_TRAVERSAL_BUDGET=20

# ================================================
# 全局配置搜索（apollo_config_global_search）
# 控制跨套跨应用全局搜索的并发度、预算、缓存。
# 默认值：8 并发 / 60s 硬上限 / 5 个常见 namespace / apps 缓存 5min / config 缓存 2min
# 调优建议：host 数 > 10 时 workers 可提到 10-12；EasyOps 延迟高时 budget 可提到 90s
# ================================================

# 并发线程数：每个 host 一个 worker 并行扫描。默认 8
# APOLLO_GLOBAL_SEARCH_WORKERS=8

# 全局搜索硬预算（秒）：覆盖 host_list + probe + 扫描全阶段，超时立即返回部分结果。默认 60
# APOLLO_GLOBAL_SEARCH_BUDGET=60

# 每个应用扫描的 namespace 上限（只在 namespaceName=application 自动扩展时生效）。默认 5
# 自动扩展顺序：application → datasource → redis → common → logging
# APOLLO_GLOBAL_SEARCH_MAX_NS=5

# apps 列表缓存秒数：同套多 app 扫描时复用，避免重复拉取。默认 300（5min）
# APOLLO_APPS_CACHE_TTL=300

# config 结果缓存秒数：同 (host, app, env, ns) 扫描时复用。默认 120（2min）
# APOLLO_CONFIG_CACHE_TTL=120

# ================================================
# Host 探活（探测各套 Apollo 是否可用，标记后遍历优先可用套）
# ================================================

# 是否开启探活。默认 true（关闭后 host_list 不探活，遍历回退原全量逻辑）
# APOLLO_HOST_PROBE_ENABLED=true

# 探活结果缓存秒数（60s 内复用，避免每次 host_list 重复探活）。默认 60
# APOLLO_HOST_PROBE_TTL=60

# 日志级别：DEBUG/INFO/WARNING/ERROR
LOG_LEVEL=INFO

# 文件日志开关：false 时不写日志文件，仅控制台输出（Docker json-file 自动轮转）
LOG_TO_FILE=false
