{
  "name": "product_query",
  "description": "查询产品信息",
  "api": {
    "method": "POST",
    "url": "https://oss.tech.ctseelink.cn/a/cmdb/baseProduct/",
    "contentType": "application/json"
  },
  "request": {
    "type": "object",
    "properties": {
      "id": {"type": "string", "description": "产品ID"},
      "name": {"type": "string", "description": "产品名称"},
      "flag": {"type": "integer", "description": "启用标志", "enum": [0, 1]},
      "currentPage": {"type": "integer", "description": "页码", "minimum": 1},
      "pageSize": {"type": "integer", "description": "每页条数", "minimum": 1, "maximum": 100}
    },
    "required": []
  },
  "response": {
    "type": "object",
    "properties": {
      "code": {"type": "integer"},
      "message": {"type": "string"},
      "data": {
        "type": "object",
        "properties": {
          "records": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "productName": {"type": "string"},
                "productFunction": {"type": "string"},
                "parentProduct": {"type": "string"},
                "productLevel": {"type": "string"},
                "enabled": {"type": "string"},
                "department": {"type": "string"},
                "productManager": {"type": "string"},
                "opsLead": {"type": "string"}
              }
            }
          },
          "total": {"type": "integer"},
          "current": {"type": "integer"},
          "size": {"type": "integer"},
          "pages": {"type": "integer"}
        }
      }
    }
  },
  "mock": {
    "enabled": true,
    "response": {
      "code": 200,
      "message": "success",
      "_mock": true
    }
  }
}
