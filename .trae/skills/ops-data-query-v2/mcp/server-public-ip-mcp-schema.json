{
  "name": "server_public_ip_query",
  "description": "查询服务器公网IP信息",
  "api": {
    "method": "POST",
    "url": "https://oss.tech.ctseelink.cn/a/cmdb/serverPublicIp/",
    "contentType": "application/json"
  },
  "request": {
    "type": "object",
    "properties": {
      "id": {"type": "string", "description": "记录ID"},
      "node": {"type": "string", "description": "机房位置"},
      "ip": {"type": "string", "description": "内网IP地址"},
      "publicIp": {"type": "string", "description": "公网IP地址"},
      "netType": {"type": "integer", "description": "网络类型", "enum": [1, 2]},
      "currentPage": {"type": "integer", "description": "页码", "minimum": 1},
      "pageSize": {"type": "integer", "description": "每页条数", "minimum": 1, "maximum": 100}
    },
    "required": []
  },
  "response": {
    "type": "object",
    "properties": {
      "code": {"type": "integer"},
      "message": {"type": "string"},
      "data": {
        "type": "object",
        "properties": {
          "records": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "publicIp": {"type": "string"},
                "publicIpv6": {"type": "string"},
                "ip": {"type": "string"},
                "vip": {"type": "string"},
                "node": {"type": "string"},
                "bandwidth": {"type": "string"},
                "bandwidthType": {"type": "string"},
                "billingType": {"type": "string"}
              }
            }
          },
          "total": {"type": "integer"},
          "current": {"type": "integer"},
          "size": {"type": "integer"},
          "pages": {"type": "integer"}
        }
      }
    }
  },
  "mock": {
    "enabled": true,
    "response": {
      "code": 200,
      "message": "success",
      "_mock": true
    }
  }
}
