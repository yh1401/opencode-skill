{
  "name": "project_basis_query",
  "description": "查询工程项目基础信息",
  "api": {
    "method": "POST",
    "url": "https://oss.tech.ctseelink.cn/a/cmdb/baseProjectBasis/",
    "contentType": "application/json"
  },
  "request": {
    "type": "object",
    "properties": {
      "id": {"type": "string", "description": "项目ID"},
      "name": {"type": "string", "description": "工程项目名称"},
      "productId": {"type": "string", "description": "产品ID"},
      "productName": {"type": "string", "description": "产品名称"},
      "currentPage": {"type": "integer", "description": "页码", "minimum": 1},
      "pageSize": {"type": "integer", "description": "每页条数", "minimum": 1, "maximum": 100}
    },
    "required": []
  },
  "response": {
    "type": "object",
    "properties": {
      "code": {"type": "integer"},
      "message": {"type": "string"},
      "data": {
        "type": "object",
        "properties": {
          "records": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "projectName": {"type": "string"},
                "chineseName": {"type": "string"},
                "productName": {"type": "string"},
                "repoPath": {"type": "string"},
                "description": {"type": "string"},
                "projectType": {"type": "string"},
                "parentProject": {"type": "string"},
                "group": {"type": "string"}
              }
            }
          },
          "total": {"type": "integer"},
          "current": {"type": "integer"},
          "size": {"type": "integer"},
          "pages": {"type": "integer"}
        }
      }
    }
  },
  "mock": {
    "enabled": true,
    "response": {
      "code": 200,
      "message": "success",
      "_mock": true
    }
  }
}
