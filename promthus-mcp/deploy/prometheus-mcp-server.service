[Unit]
Description=Prometheus MCP Server (HTTP transport)
Documentation=https://github.com/tjhop/prometheus-mcp-server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple

# 可执行文件与配置来源
ExecStart=/usr/local/bin/prometheus-mcp-server
EnvironmentFile=-/etc/prometheus-mcp-server/prometheus-mcp-server.env

# 运行身份：由 systemd 分配动态系统用户，无需手动 useradd
# 如需使用固定用户，请改为 User=/Group= 并先创建对应账户
DynamicUser=true

# 重启策略：异常退出后 5s 拉起
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s

# 日志：写入 stdout/stderr，由 journald 统一采集（journalctl -u prometheus-mcp-server）
StandardOutput=journal
StandardError=journal
SyslogIdentifier=prometheus-mcp-server

# 安全加固（需 systemd >= 232，即 CentOS 8+/Ubuntu 18.04+）
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
SystemCallArchitectures=native
# 监听端口 >= 1024，无需任何 capabilities
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
