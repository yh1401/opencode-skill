# Prometheus MCP Server 环境变量配置
# 由 systemd 通过 EnvironmentFile 加载（见 prometheus-mcp-server.service）
# 变量名 = PROMETHEUS_MCP_SERVER_ + 命令行标志（大写，. 与 - 替换为 _）
# 例如 --mcp.transport 对应 PROMETHEUS_MCP_SERVER_MCP_TRANSPORT

# ---- MCP 传输与监听 ----
PROMETHEUS_MCP_SERVER_MCP_TRANSPORT=http
PROMETHEUS_MCP_SERVER_WEB_LISTEN_ADDRESS=:8090
PROMETHEUS_MCP_SERVER_MCP_SESSION_TIMEOUT=10m
PROMETHEUS_MCP_SERVER_MCP_KEEPALIVE_INTERVAL=30s
# 无状态模式：取消 Mcp-Session-Id 下发与校验（纯工具服务适用）
PROMETHEUS_MCP_SERVER_MCP_STATELESS=true

# ---- Prometheus 连接 ----
PROMETHEUS_MCP_SERVER_PROMETHEUS_URL=http://183.56.210.90:8082
PROMETHEUS_MCP_SERVER_PROMETHEUS_TIMEOUT=1m
# 单次查询返回给 LLM 的最大条目数：series / label_values 全量返回会撑爆上下文
# （生产环境 deployment 约 1.8 万、pod 约 8 千，需截断并提示调用方收窄选择器）
PROMETHEUS_MCP_SERVER_PROMETHEUS_TRUNCATION_LIMIT=2000

# ---- easyviews 架构分析工具（未配置 app-id/app-secret 时相关工具不可用）----
PROMETHEUS_MCP_SERVER_EASYVIEWS_PROVINCE=大模型
PROMETHEUS_MCP_SERVER_EASYVIEWS_APP_ID=YOUR_EASYVIEWS_APP_ID
PROMETHEUS_MCP_SERVER_EASYVIEWS_APP_SECRET=YOUR_EASYVIEWS_APP_SECRET
PROMETHEUS_MCP_SERVER_EASYVIEWS_TIMEOUT=30s

# ---- 日志 ----
PROMETHEUS_MCP_SERVER_LOG_LEVEL=info
PROMETHEUS_MCP_SERVER_LOG_FORMAT=logfmt
