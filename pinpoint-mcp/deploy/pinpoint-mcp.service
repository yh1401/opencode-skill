# Pinpoint MCP Server - systemd 服务配置
#
# 使用方法：
#   1. 将本文件上传至服务器 /etc/systemd/system/pinpoint-mcp.service
#   2. 代码位于 /fortress/pinpoint-mcp/pinpoint-mcp-server
#   3. 如服务以 mcp 用户运行，先创建用户：
#        sudo useradd -r -s /usr/sbin/nologin -d /fortress/pinpoint-mcp/pinpoint-mcp-server mcp
#        sudo chown -R mcp:mcp /fortress/pinpoint-mcp
#   4. 执行：
#        sudo systemctl daemon-reload
#        sudo systemctl enable --now pinpoint-mcp
#   5. 常用命令：
#        sudo systemctl status pinpoint-mcp     # 查看状态
#        sudo journalctl -u pinpoint-mcp -f          # 实时查看日志
#        sudo systemctl restart pinpoint-mcp    # 重启
#
# 凭据环境文件：
#   sudo tee /home/fortress/pinpoint-mcp/pinpoint-mcp-server/mcp.env >/dev/null <<'EOF'
#   # Pinpoint：formLogin 账号（PINPOINT_USER/PINPOINT_PASS）与 Basic 认证二选一，
#   # Basic 为 Base64 编码的 "user:pass"，设置后优先于 formLogin
   PINPOINT_BASIC_AUTH=YOUR_PINPOINT_BASIC_AUTH
#   # EasyViews 平台凭据（必填，无默认值；缺失时所有 EasyViews 类工具报错）
   EASYVIEWS_APP_ID=YOUR_EASYVIEWS_APP_ID
   EASYVIEWS_APP_SECRET=YOUR_EASYVIEWS_APP_SECRET
#   # 节点标签口径：显式设为空表示关闭映射表，广州4d 等节点改回 cmdb_node 取数；
#   # 如需保留部分节点映射，写成 "节点=cluster值;节点2=值2"（例如 云公司->某节点=某集群）
   ARCH_NODE_CLUSTER_MAP=
#   EOF

    sudo chmod 600 /home/fortress/pinpoint-mcp/pinpoint-mcp-server/mcp.env
    sudo chown mcp:mcp /home/fortress/pinpoint-mcp/pinpoint-mcp-server/mcp.env
[Unit]
Description=Pinpoint MCP Server
Documentation=file:///home/fortress/pinpoint-mcp/pinpoint-mcp-server/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# 运行用户：建议使用专用系统用户；如用 root 请删除本行
User=mcp
# 认证凭据统一从环境文件读取（mcp.env 中二选一设置）：
#   formLogin：PINPOINT_USER / PINPOINT_PASS
#   Basic 认证：PINPOINT_BASIC_AUTH（Base64 的 "user:pass"，优先于 formLogin）
EnvironmentFile=/home/fortress/pinpoint-mcp/pinpoint-mcp-server/mcp.env
WorkingDirectory=/home/fortress/pinpoint-mcp/pinpoint-mcp-server
ExecStart=/home/fortress/pinpoint-mcp/pinpoint-mcp-server/.venv/bin/python server.py
# Pinpoint Web 地址（如与 MCP Server 同机，保持默认）
Environment=WEB_BASE_URL=https://trace-api.tech.ctseelink.cn:52080/serverMap
# MCP 监听地址与端口
Environment=MCP_HOST=0.0.0.0
Environment=MCP_PORT=8888
# 默认查询时间范围（分钟）
Environment=DEFAULT_RANGE_MINUTES=5

# 崩溃/重启策略：失败 5 秒后自动拉起
Restart=always
RestartSec=5
# 限制：进程最多重启次数（防死循环）
StartLimitIntervalSec=0
StartLimitBurst=10

# 安全加固（可选，按需启用）
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
# 注意：WorkingDirectory 在 /home 下时不能用 ProtectHome=true（会导致 CHDIR 失败），用 read-only
ProtectHome=read-only
ReadWritePaths=/home/fortress/pinpoint-mcp/pinpoint-mcp-server

[Install]
WantedBy=multi-user.target
