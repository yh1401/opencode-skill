# ================================================
# cmdb-mcp-server 环境配置模板
# 复制为 .env 并填写真实值: cp .env.example .env
# ================================================

# Mock 数据开关（测试环境通常为 false，API 不可用时自动降级）
MCP_USE_MOCK=false

# CMDB API 基础地址
MCP_API_BASE_URL=https://oss.tech.ctseelink.cn

# 日志级别：DEBUG/INFO/WARNING/ERROR
LOG_LEVEL=INFO
