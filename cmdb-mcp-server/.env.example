# ================================================
# cmdb-mcp-server 环境配置模板
# 复制为 .env 并填写真实值: cp .env.example .env
# ================================================

# Mock 数据开关（测试环境通常为 false，API 不可用时自动降级）
MCP_USE_MOCK=false

# CMDB API 基础地址
MCP_API_BASE_URL=https://oss.tech.ctseelink.cn

# 日志级别：DEBUG/INFO/WARNING/ERROR
LOG_LEVEL=INFO

# 文件日志开关：false 时不写日志文件，仅控制台输出（Docker json-file 自动轮转）
LOG_TO_FILE=false

# ================================================
# 超时与重试（影响 agent 响应速度）
# 正常请求毫秒级返回不受影响；以下仅在异常/超时时触发，快速失败避免 agent 卡死。
# ================================================

# 单次请求超时（秒）。默认 8
# CMDB_REQUEST_TIMEOUT=8

# 超时/连接失败重试次数（0=不重试）。默认 1
# CMDB_MAX_RETRIES=1

# 重试间隔（秒）。默认 1
# CMDB_RETRY_DELAY=1
